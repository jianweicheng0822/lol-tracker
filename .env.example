# =============================================================
# LoL Tracker — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# Riot Games API key — https://developer.riotgames.com
RIOT_API_KEY=RGAPI-your-key-here

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# JWT secret — any random string (min 256 bits / 32 chars)
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# PostgreSQL credentials (defaults work with docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lol_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (defaults work with docker-compose)
REDIS_HOST=localhost
REDIS_PASSWORD=changeme

# CORS allowed origin — must match where the frontend is served from.
# Local dev (Vite on :5173) needs http://localhost:5173; set your domain in production.
CORS_ORIGIN=http://localhost:5173

# Public frontend URL used for Stripe Checkout redirects (set your domain in production)
APP_BASE_URL=http://localhost:5173

# Stripe (optional — required for PRO subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# OAuth login (optional — required for Google / Discord sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
